{
  "name": "marquee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marquee: one ad server + console for every app at mutaafaziz.com (Google AdSense/H5 Games Ads + direct sponsors).",
  "engines": { "node": ">=22" },
